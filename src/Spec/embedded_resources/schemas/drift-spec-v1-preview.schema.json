{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hojmark.github.io/drift/schemas/drift-spec-v1-preview.schema.json",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "v1-preview"
    },
    "network": {
      "type": "object",
      "properties": {
        "subnets": {
          "type": [
            "null",
            "array"
          ],
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": [
                  "null",
                  "string"
                ]
              },
              "address": {
                "type": "string"
              },
              "enabled": {
                "type": [
                  "null",
                  "boolean"
                ]
              }
            },
            "required": [
              "address"
            ],
            "additionalProperties": false
          }
        },
        "devices": {
          "type": [
            "null",
            "array"
          ],
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": [
                  "null",
                  "string"
                ]
              },
              "addresses": {
                "type": "object",
                "properties": {
                  "ipv4": {
                    "type": [
                      "null",
                      "string"
                    ]
                  },
                  "mac": {
                    "type": [
                      "null",
                      "string"
                    ]
                  },
                  "hostname": {
                    "type": [
                      "null",
                      "string"
                    ]
                  }
                },
                "additionalProperties": false
              },
              "info": {
                "type": [
                  "null",
                  "object"
                ],
                "properties": {
                  "ipv4": {
                    "type": [
                      "null",
                      "string"
                    ]
                  },
                  "mac": {
                    "type": [
                      "null",
                      "string"
                    ]
                  },
                  "hostname": {
                    "type": [
                      "null",
                      "string"
                    ]
                  }
                },
                "additionalProperties": false
              },
              "state": {
                "enum": [
                  "up",
                  "dynamic",
                  "down",
                  null
                ]
              },
              "enabled": {
                "type": [
                  "null",
                  "boolean"
                ]
              }
            },
            "required": [
              "addresses"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "server": {
      "type": [
        "null",
        "object"
      ],
      "properties": {
        "address": {
          "type": "string"
        }
      },
      "required": [
        "address"
      ],
      "additionalProperties": false
    },
    "settings": {
      "type": [
        "null",
        "object"
      ],
      "properties": {
        "unknown_devices": {
          "enum": [
            "disallowed",
            "allowed",
            null
          ]
        },
        "undeclared_connections": {
          "enum": [
            "blocked",
            "reachable",
            null
          ]
        },
        "ping_throttling": {
          "type": [
            "null",
            "integer"
          ]
        },
        "scan_only_declared_subnets": {
          "type": [
            "null",
            "boolean"
          ]
        }
      },
      "additionalProperties": false
    },
    "agents": {
      "type": [
        "null",
        "array"
      ],
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "policy": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "object",
              "properties": {
                "to": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "expect": {
                  "type": "string"
                },
                "port": {
                  "type": [
                    "null",
                    "array"
                  ],
                  "items": {
                    "type": "integer"
                  }
                },
                "protocol": {
                  "type": [
                    "null",
                    "string"
                  ]
                },
                "probe": {
                  "type": [
                    "null",
                    "array"
                  ],
                  "items": {
                    "type": "string"
                  }
                },
                "fallback": {
                  "type": [
                    "null",
                    "string"
                  ]
                }
              },
              "required": [
                "to",
                "expect"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "address"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "network"
  ],
  "title": "Drift spec schema",
  "description": "JSON schema for validating Drift specs",
  "additionalProperties": false
}